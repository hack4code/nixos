#! env bash


source "$(dirname $0)/swaylib"


function resume_system {
    curl -s -o /dev/null -X GET 'http://127.0.0.1:8080/system/resume'
}


function resume_kremap {
    sudo systemctl restart kremap.service
}


resume_kremap
resume_system
resume_sound


