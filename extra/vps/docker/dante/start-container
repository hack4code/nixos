#!/usr/bin/env bash


NAME="dante"

IF="eth0"
IP="127.0.0.1"

WGIF=$(wg show interfaces | head --lines=1)
if [[ -n "$WGIF" ]]; then
    IP=$(ip -4 -oneline addr show dev "$WGIF" | awk '{print $4;exit}' | cut -d/ -f1)
fi
NET="$(echo "$IP" | sed -E 's/[^.]+$/0/')/24"

if docker container list --all --format '{{.Names}}' | grep -q "$NAME"; then
    docker container stop $NAME
    docker container rm $NAME
    docker image rm $NAME
fi

echo "build image ..."
docker image build \
    --build-arg IP="$IP" \
    --build-arg IF="$IF" \
    --build-arg NET="$NET" \
    --no-cache \
    -t $NAME \
    .

echo "create container ..."
docker container create \
    --network host \
    --restart always \
    --memory 512m \
    --memory-swap 1G \
    --name $NAME \
    $NAME

echo "start container..."
docker container start $NAME


