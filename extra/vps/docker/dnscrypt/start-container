#!/usr/bin/env bash


NAME='dnscrypt'
IMAGE='jedisct1/dnscrypt-server'
PORT='6666'
IF='wg0'

ZONE="$HOME/.config/dnscrypt/zones"
IP6=$(ip -6 -oneline addr show dev $IF scope global | awk '{print $4; exit}' | cut -d/ -f1)


echo 'rm container...'
if (docker container list --all --format '{{.Names}}' | grep -q $NAME); then
    docker container stop $NAME
    docker container rm $NAME
    docker image rm $IMAGE
fi

if [[ ! -d $ZONE ]]; then
    echo "mkdir $ZONE..."
    mkdir -p "$ZONE/"
fi

echo 'pull image...'
docker image pull "$IMAGE"

echo 'start container...'
docker container run \
    --detach \
    --restart always \
    --network host \
    --volume "$ZONE:/opt/unbound/etc/unbound/zones" \
    --name $NAME \
    $IMAGE \
    init -N 'dnscrypt.linode' -E "[$IP6]:$PORT"


