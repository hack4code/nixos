[Unit]
Description=shadowsocks

[Container]
Label=app=shadowsocks
ContainerName=shadowsocks
Image=localhost/shadowsocks
Network=podmanv6.network
PublishPort=127.0.0.1:1080:1080
PodmanArgs=--memory 256m --memory-swap 1g
Exec=sslocal -c /etc/shadowsocks.json

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target
