[Interface]
Address = ${IP4S}, ${IP6S}
PrivateKey = ${KEYPRIS}
ListenPort = ${LPORTS}
PostUP = ethtool -K ${IFS} rx-gro-list off
PostUP = ethtool -K ${IFS} rx-udp-gro-forwarding on
PostUP = tc qdisc add dev %i root fq_codel
PostUP = nft -f /etc/wireguard/wireguard.nft
PostDown = nft delete table inet wireguard-forward; nft delete table ip wireguard-nat;
