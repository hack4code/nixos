#! /usr/bin/env bash


if (($# != 1)); then
    exit
fi


SHA256=$(curl -s https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc | grep -F "$1.tar.xz" | cut -d ' ' -f 1 | tr -d '\s\n')
if [[ -z "$SHA256" ]]; then
    echo "no signature found" 2>&1
    exit
fi


sed -i -E "/kernelVersion/s/\".+\"/\"$1\"/" ~/source/nixos/config/os.nix
sed -i -E "/kernelSha256/s/\".+\"/\"$SHA256\"/" ~/source/nixos/config/os.nix


# vim: ts=4 sw=4 sts=4 ft=bash et:
