#!/usr/bin/env bash


function setup_network_service {
    local SYSTEMD="$HOME/.config/containers/systemd"
    if ! [[ -d "$SYSTEMD" ]]; then
        mkdir -p "$SYSTEMD/"
    fi

    cp podmanv6.network "$SYSTEMD/"

    local V6RANGE
    V6RANGE=$(linode-cli networking v6-ranges --json | jq -r '.[].range')
    if [[ -z "$V6RANGE" ]]; then
        echo "no v6range found" 1>&2
        exit 1
    fi
    local SUBNET
    SUBNET=$(echo "$V6RANGE" | sed -E 's;:+$;:bbbb::/80;')
    sed -i -E "/Subnet/s;=.+;=$SUBNET;" "$SYSTEMD/podmanv6.network"

    echo "reload systemd..."
    systemctl --user daemon-reload
}


setup_network_service


