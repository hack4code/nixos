[Unit]
Description=fetchmail

[Container]
Label=app=fetchmail
ContainerName=fetchmail
Network=podmanv6.network
AddHost=%H:127.0.0.1
Image=localhost/fetchmail
UserNS=keep-id:uid=%U,gid=%G
Volume=%h/mail:%h/mail
WorkingDir=%h
Exec=fetchmail -N -d3600

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target
