#!/usr/bin/env bash


NAME="fetchmail"
VOLUME="$HOME/mail/"


function clean_container {
    if [[ "$(systemctl --user is-active $NAME)" == active ]]; then
        systemctl --user stop $NAME
    fi
    if podman container list --format '{{.Names}}' | grep -q $NAME; then
        podman container stop $NAME
    fi
    if podman container list --all --format '{{.Names}}' | grep -q $NAME; then
        podman container rm $NAME
    fi
    if podman image list --all --format "{{.Repository}}" | grep -q $NAME; then
        podman image rm $NAME
    fi
}


function setup_systemd_service {
    local SYSTEMD="$HOME/.config/containers/systemd/"
    if ! [[ -d "$SYSTEMD" ]]; then
        echo "mkdir $SYSTEMD"
        mkdir -p "$SYSTEMD/"
    fi

    cp fetchmail.container "$SYSTEMD/"

    echo "reload systemd ..."
    systemctl --user daemon-reload
}


USERNAME=$(bw list items --search fetchmail | jq -r '.[].login.username')
PASSWORD=$(bw list items --search fetchmail | jq -r '.[].login.password')
if [[ -z "$USERNAME" ]] || [[ -z "$PASSWORD" ]]; then
    echo "no username or passpword found"
    exit 1
fi

echo "clean container ..."
clean_container

echo "build image ..."
podman image build \
    --build-arg HOME="$HOME" \
    --build-arg USER="$USER" \
    --build-arg UID="$(id --user)" \
    --build-arg GID="$(id --group)" \
    --build-arg USERNAME="$USERNAME" \
    --build-arg PASSWORD="$PASSWORD" \
    --no-cache \
    -t $NAME \
    .

if ! [[ -d "$VOLUME" ]]; then
    echo "mkdir mail ..."
    mkdir -p "$VOLUME/"
fi

setup_systemd_service

echo "restart systemd service ..."
systemctl --user restart $NAME


# vim: ts=4 sw=4 sts=4 ft=bash et:
