#!/usr/bin/env python


import os
import sys
import time
import signal
import argparse

from rpcdaemon import Server


def kill_rpcd(pid_file: str) -> None:
    try:
        with open(pid_file, 'r') as f:
            pid = int(f.read().strip())
    except IOError:
        return
    sys.stdout.write(f"killing rpcd[{pid}]\n")
    sys.stdout.flush()
    os.kill(pid, signal.SIGTERM)
    for _ in range(300):
        time.sleep(0.2)
        if not os.path.exists(pid_file):
            return
    sys.stderr.write("rpcd can't killed\n")
    sys.stderr.flush()
    sys.exit(1)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="RPC Daemon")
    parser.add_argument(
        "--port",
        type=int,
        default=8080,
        help="listen port"
    )
    parser.add_argument(
        "--host",
        type=str,
        default="127.0.0.1",
        help="listen address"
    )
    parser.add_argument(
        "--pid",
        type=str,
        default=f"/var/run/user/{os.getuid()}/rpcd/pid",
        help="pid file"
    )
    args = parser.parse_args()
    host, port, pid_file = args.host, args.port, args.pid
    os.makedirs(os.path.dirname(pid_file), exist_ok=True)
    kill_rpcd(pid_file)
    server = Server(
        host,
        port,
        pidfile=pid_file
    )
    server.start()


